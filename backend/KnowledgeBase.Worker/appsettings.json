{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      // The poll loop runs a SELECT every few seconds - do not narrate each one.
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Ai": {
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "Model": "qwen2.5vl:7b",
      "Options": {
        "Temperature": 0.2,
        "NumCtx": 8192
      }
    }
  },
  "Pipeline": {
    "PollInterval": "00:00:05",
    "OutageDelay": "00:00:30",
    "MaxAttempts": 3,
    "MaxSourceChars": 12000
  },
  "Storage": {
    "S3": {
      "Region": "auto"
    }
  }
}
