# Copy to worker.env (gitignored) and fill in. docker-compose.yml reads it as env_file.
# Prod credentials: Neon (prod DB) and R2 (prod bucket). Never commit the filled copy.
#
# No quotes. Everything after the first = is the value; ; and spaces are fine.

# Neon pooled connection string, ADO.NET "key=value" form - NOT the postgresql:// URL Neon shows.
ConnectionStrings__Database=Host=EXAMPLE-pooler.eu-central-1.aws.neon.tech;Database=neondb;Username=EXAMPLE;Password=EXAMPLE;SSL Mode=Require

# Cloudflare R2
Storage__S3__ServiceUrl=https://EXAMPLE.r2.cloudflarestorage.com
Storage__S3__BucketName=knowledgebase-assets
Storage__S3__AccessKeyId=
Storage__S3__SecretAccessKey=

# Live note updates: the worker POSTs a change hint to the API after each note, so open
# browsers refresh without a reload. IngestToken must match Events__IngestToken on the API
# (Render env var). Leave both blank to disable - notes then appear only on page reload.
Events__ApiBaseUrl=https://knowledgebase-9z29.onrender.com
Events__IngestToken=
